releases/*.exe
releases/*.exe.sha256
releases/version.json
!releases/.gitkeep

# PyInstaller / frozen leftovers
*.exe
*.exe.new
*.exe.bak
_update_conjure_finder.bat
_update_conjure_finder.ps1
_update_fail.txt
_UPDATE_START_HERE.txt

